  "$id": "urn:sdg:run-manifest:0.3",
  "title": "SDG Run Manifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "configuration",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
