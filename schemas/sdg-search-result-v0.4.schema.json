{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdg:search-result:0.4",
  "title": "SDG Search Result v0.4 authoritative scalar height context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputReferences",
    "constraintContext",
    "search",
    "summary",
    "rankedCandidates",
    "rejections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4"
    },
    "inputReferences": {
      "$ref": "urn:sdg:search-result:0.1#/properties/inputReferences"
    },
    "constraintContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaBasis",
        "constraintCaps",
        "floorAreaRatio",
        "height"
      ],
      "properties": {
        "areaBasis": {
          "$ref": "urn:sdg:constraint-result:0.1#/properties/areaBasis"
        },
        "constraintCaps": {
          "$ref": "urn:sdg:constraint-result:0.3#/$defs/contextCaps"
        },
        "floorAreaRatio": {
          "$ref": "urn:sdg:constraint-result:0.2#/$defs/floorAreaRatio"
        },
        "height": {
          "$ref": "urn:sdg:constraint-result:0.3#/$defs/height"
        }
      }
    },
    "search": {
      "$ref": "urn:sdg:search-result:0.1#/properties/search"
    },
    "summary": {
      "$ref": "urn:sdg:search-result:0.1#/properties/summary"
    },
    "rankedCandidates": {
      "$ref": "urn:sdg:search-result:0.1#/properties/rankedCandidates"
    },
    "rejections": {
      "$ref": "urn:sdg:search-result:0.1#/properties/rejections"
    }
  }
}
